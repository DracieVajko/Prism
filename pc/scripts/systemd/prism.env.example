# Prism systemd environment (copy to /etc/prism.env and edit).
#
# Only set what you need; every value has a sane default. Models are loaded
# lazily on the first request, so nothing here is required for a basic install.

# Where the server listens. 8101 is the contract; change only if it is taken.
# PRISM_PORT=8101

# Idle timeout before a resident model is released (seconds).
# UNIFIED_IDLE_UNLOAD_SECONDS=900

# Whisper: CPU int8 by default. Set to cuda for GPU transcription.
# WHISPER_DEVICE=cpu

# ONNX provider for the LCM image pipeline: auto | cuda | dml | cpu
# PRISM_ONNX_PROVIDER=auto

# Upscale backend: torch | onnx | pillow
# PRISM_UPSCALE_ENGINE=torch

# Cloud AI for transcription post-processing / action extraction. Any one of:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# PRISM_AI_PROVIDER=openai

# Hugging Face token (only needed for gated model downloads).
# HF_TOKEN=
